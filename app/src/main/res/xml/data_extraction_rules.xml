<?xml version="1.0" encoding="utf-8"?>
<!-- AmpTrack stores only local settings and calculation history in DataStore;
     both are eligible for the platform's standard backup and device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
